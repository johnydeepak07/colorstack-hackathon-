# Copy this file to .env and fill in what you have. Everything is optional.

# Real AI replies (free key at https://console.groq.com/keys). Blank = fake replies.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Real score storage. Blank = scores live in memory and reset on restart.
MONGODB_URI=

# Pin one task (1-25) instead of rotating daily - handy for the demo.
TASK_ID=
